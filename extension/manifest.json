{
  "manifest_version": 3,
  "name": "Harness Builder",
  "short_name": "Harness Builder",
  "version": "0.1.0",
  "description": "Claude Code / Codex 用のハーネス（指示ファイル・スキル・サブエージェント・権限設定）を、資料とヒアリングから生成します。",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Harness Builder を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
